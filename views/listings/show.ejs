<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wanderlust - <%= listing.title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/starability/2.4.2/starability-all.min.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    body {
      font-family: "Plus Jakarta Sans", sans-serif;
    }
    .navbar {
      height: 5rem;
      background-color: white;
      border-bottom: 1px solid #e8e8e8;
    }
    .fa-compass {
      color: #fe424d;
      font-size: 2rem;
    }
    .nav-link {
      color: #222222 !important;
      font-weight: 500;
    }
    .show-card {
      border: none;
    }
    .show-img {
      height: 30vh;
      border-radius: 1rem;
      object-fit: cover;
    }
    #map {
      height: 400px;
      width: 100%;
      border-radius: 10px;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-md sticky-top">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>
      <div class="navbar-nav me-auto d-flex flex-row gap-3">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/listings">All Listings</a>
        <a class="nav-link" href="/listings/new">Add new Listing</a>
      </div>
      <div class="navbar-nav ms-auto d-flex flex-row gap-3">
        <% if (!locals.currUser) { %>
          <a class="nav-link" href="/signup">Sign up</a>
          <a class="nav-link" href="/login">Log in</a>
        <% } else { %>
          <a class="nav-link" href="/logout">Log out</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="row">
      <div class="col-8 offset-2">
        <h3 class="fw-bold mb-3"><%= listing.title %></h3>
        
        <div class="card show-card mb-3">
          <% if (listing.image && listing.image.url) { %>
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>" />
          <% } else { %>
            <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800" class="card-img-top show-img" alt="listing" />
          <% } %>
          <div class="card-body px-0">
            <p class="card-text text-muted mb-1"><%= listing.description %></p>
            <p class="card-text fs-5 fw-semibold mb-1">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> / night</p>
            <p class="card-text text-muted"><%= listing.location %>, <%= listing.country %></p>
          </div>
        </div>

        <div class="d-flex gap-3 mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark" style="background-color: #fe424d; border:none;">Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button type="submit" class="btn btn-dark">Delete</button>
          </form>
          <a href="/listings" class="btn btn-outline-secondary">Back</a>
        </div>

        <hr />

        <!-- Reviews Section -->
        <div class="mb-4">
          <h4>Leave a Review</h4>
          <form action="/listings/<%= listing.id %>/reviews" method="POST" class="mb-3">
            <div class="mb-3 mt-3">
              <label for="rating" class="form-label">Rating</label>
              <fieldset class="starability-basic">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label">Comments</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
          </form>

          <% if (listing.reviews && listing.reviews.length > 0) { %>
            <hr />
            <h5 class="mb-3">All Reviews</h5>
            <div class="row">
              <% for(review of listing.reviews) { %>
                <div class="card col-5 ms-3 mb-3 p-3 border">
                  <div class="card-body">
                    <h6 class="card-title fw-bold">@demo</h6>
                    <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                    <p class="card-text text-muted"><%= review.comment %></p>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                  </div>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>

        <hr />

        <!-- Map Section -->
        <div class="mb-4">
          <h4 class="fw-bold mb-3">Where you'll be</h4>
          <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
          <div 
            id="map" 
            data-location="<%= (listing.location || '') + ', ' + (listing.country || '') %>"
            data-title="<%= listing.title %>"
            data-coordinates="<%= JSON.stringify(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2 ? listing.geometry.coordinates : null) %>"
          ></div>
        </div>

      </div>
    </div>
  </div>

  <footer class="footer mt-5 p-3 text-center bg-light border-top">
    <div class="d-flex justify-content-center gap-3 fs-5 text-muted">
      <i class="fa-brands fa-square-facebook"></i>
      <i class="fa-brands fa-square-instagram"></i>
      <i class="fa-brands fa-linkedin"></i>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    const mapElement = document.getElementById('map');
    const locationQuery = mapElement.dataset.location || '';
    const listingTitle = mapElement.dataset.title || '';
    let coordinates = null;
    try {
      coordinates = JSON.parse(mapElement.dataset.coordinates);
    } catch (e) {
      coordinates = null;
    }

    function renderMap(lat, lng) {
      const map = L.map('map').setView([lat, lng], 10);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      L.marker([lat, lng]).addTo(map)
        .bindPopup("<h5 class='m-0 fw-bold'>" + listingTitle + "</h5><p class='m-0 text-muted'>Exact location provided after booking</p>")
        .openPopup();
    }

    if (coordinates && coordinates.length === 2) {
      // GeoJSON is [longitude, latitude], Leaflet is [latitude, longitude]
      renderMap(coordinates[1], coordinates[0]);
    } else {
      // Dynamic fallback geocoding using the listing location name
      fetch("https://nominatim.openstreetmap.org/search?format=json&q=" + encodeURIComponent(locationQuery))
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data && data.length > 0) {
            renderMap(parseFloat(data[0].lat), parseFloat(data[0].lon));
          } else {
            // Default fallback
            renderMap(28.6139, 77.2090);
          }
        })
        .catch(function(err) {
          console.log("Map location error:", err);
          renderMap(28.6139, 77.2090);
        });
    }
  </script>
</body>
</html>
