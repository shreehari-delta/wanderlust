<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wanderlust</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body {
      font-family: "Plus Jakarta Sans", sans-serif;
    }
    .navbar {
      height: 80px;
      border-bottom: 1px solid #e2e2e2;
    }
    .fa-compass {
      color: #fe424d;
      font-size: 2rem;
    }
    .search-input {
      border-radius: 25px;
      padding: 0.5rem 1.5rem;
    }
    .search-btn {
      background-color: #fe424d;
      color: white;
      border-radius: 25px;
      padding: 0.5rem 1.5rem;
    }
    .filter-container {
      display: flex;
      align-items: center;
      gap: 2rem;
      overflow-x: auto;
      padding: 1rem 0;
    }
    .filter {
      text-align: center;
      opacity: 0.7;
      cursor: pointer;
    }
    .filter:hover {
      opacity: 1;
      border-bottom: 2px solid black;
    }
    .filter i {
      font-size: 1.5rem;
    }
    .filter p {
      font-size: 0.8rem;
      margin: 0;
    }
    .tax-toggle {
      border: 1px solid #ddd;
      border-radius: 1rem;
      padding: 0.8rem;
      display: flex;
      align-items: center;
      min-width: 250px;
    }
    .listing-card {
      border: none;
      margin-bottom: 2rem;
    }
    .card-img-top {
      border-radius: 1rem !important;
      height: 280px;
      object-fit: cover;
    }
    .card-body {
      padding: 0.5rem 0;
    }
    .tax-info {
      display: none;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-md bg-body-light sticky-top bg-white">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
        <i class="fa-regular fa-compass"></i>
        <span style="font-weight: bold; color: #fe424d;">WanderLust</span>
      </a>
      
      <div class="navbar-nav mx-auto">
        <form class="d-flex" role="search">
          <input class="form-control me-2 search-input" type="search" placeholder="Search destinations" aria-label="Search">
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        </form>
      </div>

      <div class="navbar-nav ms-auto d-flex align-items-center gap-3">
        <a class="nav-link text-dark fw-semibold" href="/listings/new">Airbnb your home</a>
        <% if (!locals.currUser) { %>
          <a class="nav-link text-dark fw-semibold" href="/signup">Sign up</a>
          <a class="nav-link text-dark fw-semibold" href="/login">Log in</a>
        <% } else { %>
          <a class="nav-link text-dark fw-semibold" href="/logout">Log out</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container mt-3">
    <!-- Filters and Tax Toggle -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div class="filter-container flex-grow-1">
        <div class="filter">
          <i class="fa-solid fa-fire"></i>
          <p>Trending</p>
        </div>
        <div class="filter">
          <i class="fa-solid fa-bed"></i>
          <p>Rooms</p>
        </div>
        <div class="filter">
          <i class="fa-solid fa-mountain-city"></i>
          <p>Iconic Cities</p>
        </div>
        <div class="filter">
          <i class="fa-solid fa-mountain"></i>
          <p>Mountains</p>
        </div>
        <div class="filter">
          <i class="fa-brands fa-fort-awesome"></i>
          <p>Castles</p>
        </div>
        <div class="filter">
          <i class="fa-solid fa-person-swimming"></i>
          <p>Amazing Pools</p>
        </div>
        <div class="filter">
          <i class="fa-solid fa-campground"></i>
          <p>Camping</p>
        </div>
        <div class="filter">
          <i class="fa-solid fa-cow"></i>
          <p>Farms</p>
        </div>
        <div class="filter">
          <i class="fa-regular fa-snowflake"></i>
          <p>Arctic</p>
        </div>
      </div>
      
      <div class="tax-toggle ms-3">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
          <label class="form-check-label" for="taxSwitch">Display total after taxes</label>
        </div>
      </div>
    </div>

    <!-- Listings Grid -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
      <% for (let listing of allListings) { %>
        <div class="col">
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
            <div class="card listing-card">
              <% if (listing.image && listing.image.url) { %>
                <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" />
              <% } else { %>
                <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=800" class="card-img-top" alt="listing" />
              <% } %>
              <div class="card-body">
                <p class="card-text">
                  <b><%= listing.title %></b> <br>
                  &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> / night
                  <i class="tax-info text-muted"> &nbsp; +18% GST</i>
                </p>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let taxSwitch = document.getElementById("taxSwitch");
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      for (info of taxInfo) {
        if (info.style.display != "inline") {
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    });
  </script>
</body>
</html>
