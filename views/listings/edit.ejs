<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Listing - WanderLust</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body {
      font-family: "Plus Jakarta Sans", sans-serif;
    }
    .navbar {
      height: 5rem;
      background-color: white;
      border-bottom: 1px solid #e8e8e8;
    }
    .fa-compass {
      color: #fe424d;
      font-size: 2rem;
    }
    .nav-link {
      color: #222222 !important;
      font-weight: 500;
    }
    .btn-edit {
      background-color: #fe424d;
      color: white;
      border: none;
    }
    .btn-edit:hover {
      background-color: #e0323c;
      color: white;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-md sticky-top">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>
      <div class="navbar-nav me-auto d-flex flex-row gap-3">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/listings">All Listings</a>
        <a class="nav-link" href="/listings/new">Add new Listing</a>
      </div>
      <div class="navbar-nav ms-auto d-flex flex-row gap-3">
        <% if (!locals.currUser) { %>
          <a class="nav-link" href="/signup">Sign up</a>
          <a class="nav-link" href="/login">Log in</a>
        <% } else { %>
          <a class="nav-link" href="/logout">Log out</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="row">
      <div class="col-8 offset-2">
        <h3 class="fw-bold mb-4">Edit your Listing</h3>
        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" id="title" class="form-control" value="<%= listing.title %>" required />
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" id="description" class="form-control" rows="3" required><%= listing.description %></textarea>
          </div>
          <div class="mb-3">
            <label for="image" class="form-label">Image Link</label>
            <input type="text" name="listing[image][url]" id="image" class="form-control" value="<%= listing.image ? listing.image.url : '' %>" />
          </div>
          <div class="row">
            <div class="mb-3 col-md-4">
              <label for="price" class="form-label">Price</label>
              <input type="number" name="listing[price]" id="price" class="form-control" value="<%= listing.price %>" required />
            </div>
            <div class="mb-3 col-md-8">
              <label for="country" class="form-label">Country</label>
              <input type="text" name="listing[country]" id="country" class="form-control" value="<%= listing.country %>" required />
            </div>
          </div>
          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" id="location" class="form-control" value="<%= listing.location %>" required />
          </div>
          <button type="submit" class="btn btn-edit mt-2">Save Changes</button>
          <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary mt-2 ms-2">Cancel</a>
        </form>
      </div>
    </div>
  </div>

  <footer class="footer mt-5 p-3 text-center bg-light border-top">
    <div class="d-flex justify-content-center gap-3 fs-5 text-muted">
      <i class="fa-brands fa-square-facebook"></i>
      <i class="fa-brands fa-square-instagram"></i>
      <i class="fa-brands fa-linkedin"></i>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
