<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SignUp - WanderLust</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body {
      font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .navbar {
      height: 5rem;
      background-color: white;
      border-bottom: 1px solid #e8e8e8;
    }
    .fa-compass {
      color: #fe424d;
      font-size: 2rem;
    }
    .nav-link {
      color: #222222 !important;
      font-weight: 500;
    }
    .content-wrap {
      flex: 1;
    }
    .footer {
      height: 4rem;
      background-color: #ebebeb;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      font-size: 1.2rem;
    }
    .footer i {
      cursor: pointer;
    }
    .btn-success {
      background-color: #28a745;
      border: none;
      padding: 0.5rem 1.25rem;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-md sticky-top">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>
      <div class="navbar-nav me-auto d-flex flex-row gap-3">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/listings">All Listings</a>
        <a class="nav-link" href="/listings/new">Add new Listing</a>
      </div>
      <div class="navbar-nav ms-auto d-flex flex-row gap-3">
        <a class="nav-link" href="/signup">Sign up</a>
        <a class="nav-link" href="/login">Log in</a>
      </div>
    </div>
  </nav>

  <div class="container mt-5 content-wrap">
    <div class="row">
      <div class="col-md-6 offset-md-3">
        <h2 class="mb-4 fw-bold">SignUp on Wanderlust</h2>
        <form method="POST" action="/signup">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" class="form-control" id="username" name="username" placeholder="random" required>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="rando" required>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" required>
          </div>
          <button type="submit" class="btn btn-success mt-2">SignUp</button>
        </form>
      </div>
    </div>
  </div>

  <footer class="footer mt-5">
    <i class="fa-brands fa-square-facebook"></i>
    <i class="fa-brands fa-square-instagram"></i>
    <i class="fa-brands fa-linkedin"></i>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
